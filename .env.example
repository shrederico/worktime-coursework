# Скопируйте структуру или выполните python3 scripts/setup_env.py.
# Настоящие пароли хранятся только в .env, который исключён из Git.
SECRET_KEY=replace-with-random-secret
POSTGRES_DB=worktime
POSTGRES_USER=worktime
POSTGRES_PASSWORD=replace-with-random-password
DEMO_PASSWORD=replace-with-at-least-12-characters
GRAFANA_PASSWORD=replace-with-random-password
ALLOWED_HOSTS=localhost,127.0.0.1,app
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
